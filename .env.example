# ─── Server ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ─── Model ────────────────────────────────────────────
GATE_MODEL=patchcore          # patchcore | efficientnet
GATE_BACKBONE=resnet18        # PatchCore 백본 (resnet18 | wide_resnet50_2)
EFFICIENTNET_VARIANT=b3       # efficientnet 게이트 variant (b0~b7)
CLASSIFIER_BACKBONE=resnet50  # resnet18 | resnet34 | resnet50
NUM_TARGETS=4

# ─── Paths ────────────────────────────────────────────
ARTIFACTS_DIR=artifacts
TARGET_IMAGES_DIR=artifacts/data/raw
LABELED_DATA_DIR=artifacts/data/labeled
AL_QUEUE_DIR=artifacts/data/al_queue
MODEL_SAVE_DIR=artifacts/models

# ─── Gate Thresholds ──────────────────────────────────
GATE_IN_THRESHOLD=0.5         # 거리 임계값: 이 이하면 Target
GATE_MARGIN_LOW=0.5           # AL 마진 구간 하단 (확실한 Target)
GATE_MARGIN_HIGH=0.8          # AL 마진 구간 상단 (확실한 OOD)

# ─── Classify Thresholds ──────────────────────────────
UNCERTAINTY_THRESHOLD=0.7     # 1등 확률 이 미만이면 AL 큐
MARGIN_THRESHOLD=0.2          # 1·2등 차이 이 미만이면 우선 라벨링

# ─── Active Learning ──────────────────────────────────
AL_QUEUE_MAX_SIZE=1000
AL_BATCH_BUDGET=50            # 한 사이클 최대 라벨링 건수

# ─── Camera ───────────────────────────────────────────
CAMERA_DEVICE_ID=0
CAMERA_FPS=30
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# ─── Metrics ──────────────────────────────────────────
METRICS_WINDOW_SIZE=100
